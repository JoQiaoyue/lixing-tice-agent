// 冒烟测试：用 DOM 打桩在 Node 中执行 index.html 内的脚本
const fs = require('fs');
const html = fs.readFileSync(__dirname + '/index.html', 'utf8');
const htmlSrc = html;
const code = html.match(/<script>([\s\S]*?)<\/script>/)[1];

const store = {};
function el(id) {
  if (!store[id]) store[id] = {
    id, value: '', textContent: '', innerHTML: '', style: {}, dataset: {},
    classList: (function(){ const c = new Set(); return { add:(x)=>c.add(x), remove:(x)=>c.delete(x), toggle:(x)=>(c.has(x)?c.delete(x):c.add(x)), contains:(x)=>c.has(x) }; })(),
    addEventListener(){}, scrollIntoView(){}, parentElement:null
  };
  return store[id];
}
const doc = {
  getElementById: el,
  querySelectorAll: () => [],
  createElement: () => el('_tmp')
};
const sandbox = {
  document: doc,
  localStorage: (() => { const m = {}; return { getItem: k => (k in m ? m[k] : null), setItem: (k,v) => { m[k]=String(v); }, removeItem: k => { delete m[k]; } }; })(),
  window: { scrollTo(){}, __natRows: null, __courseRows: null },
  console,
  alert: m => console.log('ALERT:', m),
  setTimeout: (fn, t) => { try { fn(); } catch(e){} },
  clearTimeout: () => {}
};
const vm = require('vm');
vm.createContext(sandbox);
sandbox.globalThis = sandbox;
// 脚本内的 const 声明位于词法作用域，需显式导出才能访问
vm.runInContext(code + '\n;globalThis.__X={NAT,COURSE,scoreFrom,parseTime,fmtTime,buildInputs,runAssess,genPlanUI,addRecord,getRecs,setTrack:(v)=>{track=v},getTrack:()=>track,doRegister,doLogin,doLogout,getUsers,saveProfile,loadProfile,renderTipTexts,renderTipVideos};', sandbox);
